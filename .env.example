# ============================================
# AI Dental Lead CRM
# Environment Variable Template
# ============================================

# --------------------------------------------
# DATABASE
# --------------------------------------------

# PostgreSQL / Neon connection string.
# Replace with the real value in .env.local
# or Vercel Environment Variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"


# --------------------------------------------
# APPLICATION
# --------------------------------------------

# Local development URL:
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set the real production URL in Vercel.
# Example:
# NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"


# --------------------------------------------
# AUTHENTICATION
# --------------------------------------------

# Generate a strong random secret for local/production use.
# Never commit the real value.
BETTER_AUTH_SECRET="replace-with-a-secure-random-secret"

# Local:
BETTER_AUTH_URL="http://localhost:3000"

# Production example:
# BETTER_AUTH_URL="https://your-project.vercel.app"


# --------------------------------------------
# AI CONFIGURATION
# --------------------------------------------

# Supported values:
# mock
# live
#
# Use mock during early development to avoid API costs.
AI_MODE="mock"

# OpenAI-compatible provider base URL.
# Required only when AI_MODE="live".
AI_BASE_URL="https://your-ai-provider.example/v1"

# Runtime AI API key.
# Required only when AI_MODE="live".
# Never commit a real key.
AI_API_KEY="replace-with-runtime-ai-api-key"

# Runtime model name.
# Example values depend on your provider.
AI_MODEL="replace-with-model-name"


# --------------------------------------------
# OPTIONAL EMAIL
# --------------------------------------------

# Email is NOT required for the initial MVP.
# Add only when outbound email is implemented.

# RESEND_API_KEY="replace-with-resend-api-key"

# EMAIL_FROM="Dental CRM <noreply@example.com>"


# --------------------------------------------
# DEMO SEED DATA (DEVELOPMENT ONLY)
# --------------------------------------------

# `npm run db:seed` creates a demo clinic with clearly fictional leads.

# Optional. Email address for the seeded demo clinic owner.
# DEMO_USER_EMAIL="owner@bright-smile-demo.test"

# Optional. When set, the demo owner can sign in with this password.
# When unset, the demo user is created WITHOUT any credential and cannot sign in.
# Use a strong, unique, throwaway value. Never commit the real value, and never
# reuse it for a real account.
# DEMO_USER_PASSWORD="choose-a-strong-throwaway-demo-password"

# Production only. The seed refuses to run when NODE_ENV/VERCEL_ENV is
# production unless this is true. Even when true, no sign-in credential is
# created in production.
# ALLOW_DEMO_SEED="false"