// AI Dental Lead CRM — database schema
// Clinic is the tenant boundary. Every clinic-owned record carries clinicId.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------------
// Enums
// --------------------------------------------

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
}

enum LeadStatus {
  NEW
  CONTACTED
  APPOINTMENT_SET
  WON
  LOST
}

enum LeadPriority {
  HOT
  WARM
  COLD
}

enum LeadUrgency {
  EMERGENCY
  IMMEDIATE
  TODAY
  THIS_WEEK
  SOON
  FLEXIBLE
  UNKNOWN
}

enum LeadIntent {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum ServiceCategory {
  EMERGENCY
  GENERAL_DENTISTRY
  CLEANING
  COSMETIC
  IMPLANTS
  ORTHODONTICS
  ROOT_CANAL
  EXTRACTION
  CROWNS
  VENEERS
  WHITENING
  DENTURES
  OTHER
  UNKNOWN
}

// Commercial value band of the treatment interest. Business prioritisation
// only — never an estimate or quote of a treatment price.
enum TreatmentValuePotential {
  LOW
  MEDIUM
  HIGH
  PREMIUM
  UNKNOWN
}

// Strength of the patient's stated need. Describes how strongly the enquiry
// expresses a need — it is not a clinical assessment.
enum PainNeedLevel {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum InsuranceStatus {
  HAS_INSURANCE
  NO_INSURANCE
  UNKNOWN
}

enum PaymentReadiness {
  READY
  NEEDS_OPTIONS
  PRICE_SENSITIVE
  UNKNOWN
}

// Patient-reported answers from the public enquiry form. These are the
// patient's own words, NOT a verified insurance or benefits check, and they are
// deliberately separate from the AI-derived InsuranceStatus.
enum PatientInsuranceStatus {
  YES
  NO
  UNKNOWN
}

// How the patient expects to pay for treatment (patient-reported). This is a
// different concept from PaymentReadiness, which is the AI's interpretation of
// how ready the lead appears to move forward financially.
enum PaymentPreference {
  INSURANCE
  SELF_PAY
  FINANCING
  UNKNOWN
}

// How quickly the clinic should follow up. Operational routing, not medicine.
enum FollowUpPriority {
  IMMEDIATE
  HIGH
  NORMAL
  LOW
}

enum FollowUpTaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum FollowUpTaskSource {
  AI
  STAFF
  SYSTEM
}

enum ContactMethod {
  EMAIL
  PHONE
  TEXT
}

enum ActivityType {
  LEAD_CREATED
  AI_ANALYSIS_STARTED
  AI_ANALYSIS_COMPLETED
  AI_ANALYSIS_FAILED
  STATUS_CHANGED
  NOTE_ADDED
  CONTACT_ATTEMPTED
  APPOINTMENT_SET
  LEAD_WON
  LEAD_LOST
  FOLLOW_UP_CREATED
  FOLLOW_UP_COMPLETED
  EMAIL_ALERT_SENT
  EMAIL_ALERT_FAILED
  LEAD_ARCHIVED
  LEAD_RESTORED
}

// --------------------------------------------
// Authentication (Better Auth)
// --------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  memberships  Membership[]
  leadNotes    LeadNote[]
  leadActivity LeadActivity[]
  createdTasks FollowUpTask[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --------------------------------------------
// CRM / multi-tenant models
// --------------------------------------------

model Clinic {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  leads       Lead[]
  analyses    LeadAnalysis[]
  notes       LeadNote[]
  activities  LeadActivity[]
  tasks       FollowUpTask[]

  @@map("clinic")
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  clinicId  String
  role      MembershipRole @default(STAFF)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
  @@index([clinicId])
  @@map("membership")
}

model Lead {
  id                     String                 @id @default(cuid())
  clinicId               String
  name                   String
  email                  String
  phone                  String
  serviceInterest        String
  preferredContactMethod ContactMethod          @default(EMAIL)
  submittedUrgency       LeadUrgency            @default(UNKNOWN)
  message                String
  consent                Boolean                @default(false)
  // Optional patient-reported answers. UNKNOWN is the safe default so existing
  // production leads stay valid without a backfill.
  patientInsuranceStatus PatientInsuranceStatus @default(UNKNOWN)
  paymentPreference      PaymentPreference      @default(UNKNOWN)
  status                 LeadStatus             @default(NEW)
  // CRM cleanup, deliberately orthogonal to `status`: NULL means active, a
  // timestamp means archived. An archived lead is hidden from the active list,
  // the dashboard metrics and open follow-ups but keeps every dependent record
  // and stays restorable. Never used for authorization — an archived lead is
  // still readable and restorable by its own clinic.
  archivedAt             DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  clinic     Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  analysis   LeadAnalysis?
  notes      LeadNote[]
  activities LeadActivity[]
  tasks      FollowUpTask[] @relation("FollowUpTaskToLead")

  @@index([clinicId])
  @@index([clinicId, createdAt])
  @@index([clinicId, status])
  @@index([clinicId, archivedAt])
  @@map("lead")
}

model LeadAnalysis {
  id                         String                  @id @default(cuid())
  clinicId                   String
  leadId                     String                  @unique
  leadScore                  Int
  priority                   LeadPriority
  urgency                    LeadUrgency
  intent                     LeadIntent
  serviceCategory            ServiceCategory
  treatmentValuePotential    TreatmentValuePotential @default(UNKNOWN)
  painNeedLevel              PainNeedLevel           @default(UNKNOWN)
  insuranceStatus            InsuranceStatus         @default(UNKNOWN)
  paymentReadiness           PaymentReadiness        @default(UNKNOWN)
  followUpPriority           FollowUpPriority        @default(NORMAL)
  recommendedFollowUpMinutes Int                     @default(240)
  summary                    String
  recommendedAction          String
  draftReply                 String
  model                      String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  clinic Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  lead   Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tasks  FollowUpTask[] @relation("FollowUpTaskToAnalysis")

  @@index([clinicId])
  @@index([clinicId, followUpPriority])
  @@map("lead_analysis")
}

// A concrete staff follow-up attached to one lead. AI-sourced tasks are
// recommendations (one open AI task per lead, upserted — never duplicated).
model FollowUpTask {
  id          String             @id @default(cuid())
  clinicId    String
  leadId      String
  title       String
  description String?
  dueAt       DateTime
  status      FollowUpTaskStatus @default(OPEN)
  priority    FollowUpPriority   @default(NORMAL)
  source      FollowUpTaskSource @default(STAFF)
  createdById String?
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  clinic    Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  lead      Lead          @relation("FollowUpTaskToLead", fields: [leadId], references: [id], onDelete: Cascade, map: "follow_up_task_lead_fkey")
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  analysis  LeadAnalysis? @relation("FollowUpTaskToAnalysis", fields: [leadId], references: [leadId], onDelete: Cascade, map: "follow_up_task_analysis_fkey")

  @@index([clinicId, status, dueAt])
  @@index([leadId, status])
  @@map("follow_up_task")
}

model LeadNote {
  id           String   @id @default(cuid())
  clinicId     String
  leadId       String
  authorUserId String
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([leadId, createdAt])
  @@map("lead_note")
}

model LeadActivity {
  id String @id @default(cuid())

  clinicId    String
  leadId      String
  actorUserId String?
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([leadId, createdAt])
  @@map("lead_activity")
}
